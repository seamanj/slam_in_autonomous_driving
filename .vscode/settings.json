{
    "cmake.configureOnOpen": false,
    "files.associations": {
        "ostream": "cpp",
        "mutex": "cpp",
        "array": "cpp",
        "string": "cpp",
        "string_view": "cpp"
    },
    // 移除 Windows 的编译器路径（在 Linux 下不需要）
    // "C_Cpp.default.compilerPath": "D:\\Software\\msys64\\ucrt64\\bin\\g++.exe",
    
    // 添加 CMake Tools 配置
    "cmake.buildDirectory": "${workspaceFolder}/build/build_main",
    "cmake.configureSettings": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${workspaceFolder}/build/install;/opt/ros/humble;/usr/local",
        "CMAKE_CXX_FLAGS": "-UHAVE_CUDA -std=c++17",
        "CMAKE_C_FLAGS": "-UHAVE_CUDA"
    },
    
    "cmake.debugConfig": {
        "args": [
            "--txt_path=/home/seamanj/Workspace/cpp_projects/slam_in_autonomous_driving/data/ch3/10.txt"
        ],
        "cwd": "${workspaceFolder}/build/build_main/bin",
        "environment": [
            {
                "name": "LD_LIBRARY_PATH",
                "value": "${workspaceFolder}/build/build_main/lib:${workspaceFolder}/build/install/lib:/opt/ros/humble/lib:/usr/local/lib:${env:LD_LIBRARY_PATH}"
            }
        ]
    }
}