{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            // 使用 CMake Tools 的启动目标路径，或者直接指定
            "program": "${command:cmake.launchTargetPath}",
            // 如果上面的命令不生效，改为直接指定：
            // "program": "${workspaceFolder}/build/build_main/bin/run_gins_pre_integ",
            "args": [
                "--txt_path=/home/seamanj/Workspace/cpp_projects/slam_in_autonomous_driving/data/ch3/10.txt"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/build_main/bin",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/build_main/lib:${workspaceFolder}/build/install/lib:/opt/ros/humble/lib:/usr/local/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}